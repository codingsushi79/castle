{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/g/:code",
      "destination": "/api?r=g&id=:code"
    },
    {
      "source": "/mod",
      "destination": "/api?r=mod"
    },
    {
      "source": "/api/((?!live$).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/live.ts": {
      "maxDuration": 300
    }
  }
}
